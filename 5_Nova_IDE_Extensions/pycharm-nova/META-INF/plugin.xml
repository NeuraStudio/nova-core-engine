<idea-plugin>
  <id>com.neurastudio.nova</id>
  <name>Nova Script</name>
  <vendor>NeuraStudio</vendor>
  <description>Official Nova Language Syntax Highlighting for JetBrains IDEs.</description>
  <version>1.1.0</version>
  <idea-version since-build="211.0"/>
  <extensions defaultExtensionNs="com.intellij">
    <fileType name="Nova" implementationClass="com.intellij.openapi.fileTypes.PlainTextFileType" extensions="nova"/>
  </extensions>
</idea-plugin>
