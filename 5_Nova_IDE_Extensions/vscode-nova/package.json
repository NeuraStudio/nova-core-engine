{
  "name": "nova-script",
  "displayName": "Nova Script Language Pack",
  "description": "Full Silicon Engine Runtime, NUPM, and 200+ Hacking Tools.",
  "version": "1.0.0",
  "publisher": "NeuraStudio",
  "icon": "icon.png",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:nova"],
  "main": "./server/server.js",
  "contributes": {
    "languages": [{
        "id": "nova", "aliases": ["Nova", "nova"], "extensions": [".nova"],
        "configuration": "./language-configuration.json"
    }],
    "grammars": [{
        "language": "nova", "scopeName": "source.nova", "path": "./syntaxes/nova.tmLanguage.json"
    }],
    "keybindings": [
        { "command": "nova.runFile", "key": "ctrl+alt+n", "mac": "cmd+alt+n", "when": "editorLangId == nova" },
        { "command": "editor.action.triggerSuggest", "key": "ctrl+space", "when": "editorLangId == nova" },
        { "command": "editor.action.formatDocument", "key": "shift+alt+f", "when": "editorLangId == nova" },
        { "command": "workbench.action.terminal.toggleTerminal", "key": "ctrl+`", "mac": "cmd+`" }
    ]
  }
}
