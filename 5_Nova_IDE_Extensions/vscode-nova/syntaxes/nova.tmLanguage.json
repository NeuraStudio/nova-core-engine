{
  "scopeName": "source.nova",
  "fileTypes": ["nova"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#modes" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#constants" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.double-slash.nova", "match": "//.*$" }]
    },
    "modes": {
      "patterns": [{ "name": "storage.modifier.mode.nova", "match": "@(Hacker|AI|Web|OS|Crypto|Standard)\\b" }]
    },
    "keywords": {
      "patterns": [{ "name": "keyword.control.nova", "match": "\\b(function|module|import|export|if|else|while|return|const|struct|unsafe|scan|nupm)\\b" }]
    },
    "strings": {
      "patterns": [{ "name": "string.quoted.double.nova", "begin": "\"", "end": "\"" }]
    },
    "constants": {
      "patterns": [{ "name": "constant.numeric.nova", "match": "\\b\\d+\\b" }]
    }
  }
}
