// ═══════════════════════════════════════════════
// MODULE: Master Execution Bridge (Tester)
// ENGINE: Nova VM Core
// ═══════════════════════════════════════════════

import Nova.3_Nova_Syntax.Lexer
import Nova.3_Nova_Syntax.RulesParser
import Nova.2_Nova_VM.PulseCompiler

module SyntaxToSilicon {
    
    // पूरा प्रोसेस एक साथ रन करना
    function ExecuteCode(raw_nova_script) {
        try {
            Nova.show("--- NOVA EXECUTION STARTED ---")
            
            // Step 1: Lexer (टोकन बनाना)
            tokens = Lexer.Tokenize(raw_nova_script)
            
            // Step 2: Parser (ग्रामर चेक करके AST बनाना)
            ast = RulesParser.Parse(tokens)
            
            // Step 3: Pulse Compiler (हार्डवेयर पल्स भेजना)
            status = PulseCompiler.CompileToSilicon(ast)
            
            if status == true {
                Nova.show("--- EXECUTION SUCCESSFUL ---")
            }
            
        } catch(err) {
            Nova.show("[CRITICAL FAILURE] " + err)
        }
    }
}

export SyntaxToSilicon
