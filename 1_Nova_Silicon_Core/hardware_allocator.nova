// ═══════════════════════════════════════════════
// MODULE: Master Hardware RAM & VRAM Allocator
// ENGINE: Nova Silicon Core
// ═══════════════════════════════════════════════

import Nova.1_Nova_Silicon_Core.PulseEmitter

module HardwareAllocator {
    
    // Memory Registers Setup
    const RAM_START_ADDR = 0x10000000
    const VRAM_START_ADDR = 0xA0000000
    
    // Tracking blocks at the silicon level
    struct MemoryBlock { start_addr, size, is_free, locked_by_thread }
    
    memory_map = []

    function InitializeSilicon() {
        Nova.show("⚙️ Mapping Raw Silicon RAM... Bypassing OS Paging...")
        // Initialize the first giant block of free memory
        initial_block = { start_addr: RAM_START_ADDR, size: Nova.system.getTotalRAM(), is_free: true, locked_by_thread: null }
        memory_map.add(initial_block)
    }

    unsafe function AllocateRAM(requested_size) {
        foreach block in memory_map {
            if block.is_free && block.size >= requested_size {
                // Split the block
                allocated_addr = block.start_addr
                block.is_free = false
                block.size = requested_size
                
                // Create remaining free block
                remaining_size = block.size - requested_size
                if remaining_size > 0 {
                    memory_map.add({ 
                        start_addr: allocated_addr + requested_size, 
                        size: remaining_size, 
                        is_free: true, 
                        locked_by_thread: null 
                    })
                }
                Nova.show("Hardware: Allocated " + requested_size + " bytes at " + allocated_addr)
                return allocated_addr
            }
        }
        ErrorHandler.Throw("OutOfMemory", "Silicon RAM completely exhausted!", 0)
    }

    unsafe function AllocateGPU(requested_size) {
        Nova.show("⚡ Allocating direct VRAM for AI/Web rendering...")
        // Direct access to GPU memory controller
        gpu_addr = VRAM_START_ADDR + Nova.math.random(0, 999999) // Simplified offset logic
        PulseEmitter.emit_pulse(gpu_addr, true) // Wake up GPU register
        return gpu_addr
    }

    unsafe function FreeMemory(address) {
        foreach block in memory_map {
            if block.start_addr == address {
                block.is_free = true
                block.locked_by_thread = null
                // Send zero voltage to wipe data securely (Anti-Forensics / Hacking mode)
                PulseEmitter.emit_pulse(address, false)
                break
            }
        }
    }
}
export HardwareAllocator
