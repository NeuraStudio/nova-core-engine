// ==========================================
//     NOVA SILICON INTERACTIVE CALCULATOR
// ==========================================

Nova.show("==========================================")
Nova.show("    WELCOME TO NOVA SCRIPT CALCULATOR     ")
Nova.show("==========================================")

// Taking Inputs from User
num1 = Nova.ask.user("Enter first number: ")
op   = Nova.ask.user("Enter operator (+, -, *, /): ")
num2 = Nova.ask.user("Enter second number: ")

Nova.show("--- COMPUTING RESULT ---")

// Math Processing
result = num1 op num2

Nova.show("Final Calculated Result:")
Nova.show(result)

Nova.show("==========================================")
Nova.show("     Calculation Finished Successfully!   ")
Nova.show("==========================================")
