// ═══════════════════════════════════════════════
// MODULE: Strict Error Handler
// ENGINE: Nova Syntax Core
// ═══════════════════════════════════════════════

module ErrorHandler {
    
    enum ErrorType { SyntaxError, TypeError, SiliconFault, NetworkError }

    // अगर कोड में कोई भी गलती हो, तो तुरंत एग्जीक्यूशन रोक देना
    function Throw(type, message, line_number) {
        // लाल रंग में एरर दिखाना (Console/Terminal)
        Nova.show("[FATAL ERROR] " + type + " at Line: " + line_number)
        Nova.show("Details: " + message)
        
        // पूरे प्रोसेस को तुरंत किल (Kill) कर देना
        Nova.vm.halt()
    }
    
    // सिंटैक्स रूल्स (Section 2) को चेक करने वाला वॉचडॉग
    function CheckSyntax(code_tokens) {
        foreach token in code_tokens {
            if !token.isValid() {
                Throw(ErrorType.SyntaxError, "Invalid Token found: " + token.value, token.line)
            }
        }
    }
}

export ErrorHandler
