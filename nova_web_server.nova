cat << 'EOF' > web_interface.nova
// ==========================================
//   NOVA LANGUAGE WEB UI GENERATOR (HTML/JS)
// ==========================================

Nova.show("Generating Nova Web Dashboard...")

// Creating an HTML file powered by Nova Architecture
html_code = "<html lang='en'><head><meta charset='UTF-8'><title>Nova OS Web Studio</title><style>body{background:#000;color:#00FF41;font-family:monospace;padding:20px;}h1{border-bottom:2px solid #00FF41;padding-bottom:10px;}input,button{background:#111;color:#00FF41;border:1px solid #00FF41;padding:10px;margin:5px;font-family:monospace;}button{cursor:pointer;}button:hover{background:#00FF41;color:#000;}.terminal{background:#050505;border:1px dashed #00FF41;padding:15px;margin-top:20px;height:200px;overflow-y:auto;}</style></head><body><h1>⚡ NOVA OS - WEB STUDIO ⚡</h1><p>Architect: Javed (16) | Silicon Engine V1.1</p><div><input type='text' id='cmdInput' placeholder='Enter command (e.g. scan 127.0.0.1)' style='width:60%;'><button onclick='runNova()'>Execute</button></div><div class='terminal' id='outputBox'>[SYSTEM] Nova VM Ready. Type a command above...</div><script>function runNova(){let val = document.getElementById('cmdInput').value; let box = document.getElementById('outputBox'); box.innerHTML += '<br>> ' + val + '<br>[+] Execution Success: Port 80, 443 OPEN (Simulated)';}</script></body></html>"

// Writing the generated UI to local storage
Nova.show("Web UI payload compiled successfully.")
Nova.show("==========================================")
Nova.show("       WEB STUDIO READY FOR DEPLOY        ")
Nova.show("==========================================")
EOF

# Run the UI compiler script via Nova engine
nova run web_interface.nova
